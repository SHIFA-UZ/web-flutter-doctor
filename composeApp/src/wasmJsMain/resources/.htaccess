# Shifa Doctor web (WEB-09): served by cPanel's Apache from the doctor site's folder.

# The app's own files.
AddType application/wasm .wasm
AddType application/javascript .js .mjs

# Every path that isn't a file opens the app (it routes itself); a missing asset stays a 404 rather than HTML;
# no directory listings.
Options -Indexes -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} !^/composeResources/
RewriteCond %{REQUEST_URI} !\.(js|mjs|wasm|json|map|png|webp|svg|ico|ttf|otf|woff2?)$ [NC]
RewriteRule ^ index.html [L]

# The code, strings (*.cvr) and icons (*.xml) aren't versioned by name: browsers check them again on each start, so a
# deploy reaches every doctor at once. Pictures and fonts change rarely.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|mjs|wasm|json|cvr|xml)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(png|webp|svg|ico|ttf|otf|woff2?)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# The download is several MB of wasm and JavaScript: compress it.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html application/javascript application/wasm application/json image/svg+xml
</IfModule>
